<Window x:Class="WcImageViewer.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:WcImageViewer.Controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="업데이트"
        Width="640"
        Height="520"
        Icon="/Assets/app.ico"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="28"
                            ResizeBorderThickness="0"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="28" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:TitleBar Grid.Row="0" Title="업데이트" />

        <Grid Grid.Row="1" Margin="20,16,20,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock x:Name="HeaderText"
                           Foreground="{DynamicResource TextBrush}"
                           FontSize="18"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap" />
                <TextBlock x:Name="VersionDetailText"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           Margin="0,7,0,0" />
            </StackPanel>

            <Border Grid.Row="1"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="12,10"
                    Margin="0,16,0,0">
                <DockPanel>
                    <Button x:Name="ReleasePageButton"
                            DockPanel.Dock="Bottom"
                            Content="릴리즈 페이지"
                            HorizontalAlignment="Right"
                            FontSize="11"
                            Padding="8,2"
                            Margin="0,8,0,0"
                            Click="OnReleasePageClick" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <TextBlock x:Name="ReleaseNotesText"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   FontSize="12"
                                   LineHeight="19"
                                   TextWrapping="Wrap" />
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <StackPanel Grid.Row="2" Margin="0,12,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="StatusText"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="PercentText"
                               Grid.Column="1"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center" />
                </Grid>

                <ProgressBar x:Name="DownloadProgress"
                             Style="{StaticResource ProgressBarStyle}"
                             Maximum="100"
                             Margin="0,8,0,0"
                             Visibility="Collapsed" />

                <Button x:Name="CancelButton"
                        Content="다운로드 취소"
                        HorizontalAlignment="Right"
                        FontSize="11"
                        Padding="8,2"
                        Margin="0,8,0,0"
                        Visibility="Collapsed"
                        Click="OnCancelClick" />

                <Border x:Name="ErrorPanel"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource InputBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="12,10"
                        Margin="0,8,0,0"
                        Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock x:Name="ErrorText"
                                   Foreground="{DynamicResource TextBrush}"
                                   TextWrapping="Wrap"
                                   FontWeight="SemiBold" />
                        <TextBox x:Name="LogPathText"
                                 IsReadOnly="True"
                                 IsTabStop="False"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="{DynamicResource TertiaryTextBrush}"
                                 FontSize="11"
                                 TextWrapping="Wrap"
                                 Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <Grid Grid.Row="3" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="HintText"
                           Text="업데이트를 적용하면 앱이 종료되고 새 버전이 시작됩니다."
                           Foreground="{DynamicResource TertiaryTextBrush}"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0" />
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button x:Name="SkipButton"
                            Content="이 버전 건너뛰기"
                            Click="OnSkipClick" />
                    <Button x:Name="ExitButton"
                            Content="그냥 종료"
                            Click="OnExitClick" />
                    <Button x:Name="UpdateButton"
                            Content="업데이트하고 종료"
                            IsDefault="True"
                            Click="OnUpdateClick" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
