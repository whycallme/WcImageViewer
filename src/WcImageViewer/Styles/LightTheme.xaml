<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Light palette only. Styles stay in DarkTheme.xaml and resolve these
         brushes through DynamicResource when this dictionary is merged last. -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F4F1EA" />
    <SolidColorBrush x:Key="ChromeBackgroundBrush" Color="#EFEBE2" />
    <SolidColorBrush x:Key="ImageAreaBrush" Color="#E5E0D6" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FBF9F4" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#F1EDE4" />
    <SolidColorBrush x:Key="HoverBrush" Color="#E8E3D8" />
    <SolidColorBrush x:Key="PressedBrush" Color="#DCD6C9" />
    <SolidColorBrush x:Key="BorderBrush" Color="#D8D2C5" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="#C4BCAD" />
    <SolidColorBrush x:Key="TextBrush" Color="#2B2925" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#6B665D" />
    <SolidColorBrush x:Key="TertiaryTextBrush" Color="#7C766B" />
    <SolidColorBrush x:Key="AccentBrush" Color="#A06B1E" />
    <SolidColorBrush x:Key="CloseHoverBrush" Color="#C42B1C" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#C9C2B3" />
    <SolidColorBrush x:Key="ChipBackgroundBrush" Color="#F1EDE4" />
    <SolidColorBrush x:Key="ChipBorderBrush" Color="#D8D2C5" />
    <SolidColorBrush x:Key="ThumbnailDockBrush" Color="#E6FAF8F2" />
    <SolidColorBrush x:Key="CheckMarkBrush" Color="#FBF9F4" />

</ResourceDictionary>
