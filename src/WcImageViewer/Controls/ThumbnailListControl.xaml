<UserControl x:Class="WcImageViewer.Controls.ThumbnailListControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:WcImageViewer.Controls">
    <UserControl.Resources>
        <controls:TileSizeConverter x:Key="TileSizeConverter" />
    </UserControl.Resources>
    <ListBox x:Name="List"
             SelectionMode="Extended"
             Background="Transparent"
             BorderThickness="0"
             Padding="0"
             ScrollViewer.CanContentScroll="True"
             VirtualizingPanel.IsVirtualizing="True"
             VirtualizingPanel.VirtualizationMode="Recycling"
             MouseDoubleClick="OnListMouseDoubleClick"
             KeyDown="OnListKeyDown"
             PreviewKeyDown="OnListPreviewKeyDown"
             PreviewMouseWheel="OnListPreviewMouseWheel"
             ScrollViewer.VerticalScrollBarVisibility="Visible">
        <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
                <controls:VirtualizingWrapPanel ItemWidth="104" ItemHeight="128" Loaded="OnWrapPanelLoaded" />
            </ItemsPanelTemplate>
        </ListBox.ItemsPanel>
        <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="2" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="SelectionBorder"
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    BorderThickness="2"
                                    CornerRadius="4"
                                    Padding="2">
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="SelectionBorder" Property="BorderBrush" Value="{DynamicResource SecondaryTextBrush}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="SelectionBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate>
            <DataTemplate>
                <StackPanel HorizontalAlignment="Center">
                    <Border Background="#FFBFBFBF"
                            CornerRadius="2"
                            Width="{Binding TileSize, RelativeSource={RelativeSource AncestorType=controls:ThumbnailListControl}, Converter={StaticResource TileSizeConverter}, ConverterParameter=8}"
                            Height="{Binding TileSize, RelativeSource={RelativeSource AncestorType=controls:ThumbnailListControl}, Converter={StaticResource TileSizeConverter}, ConverterParameter=32}">
                        <Grid>
                            <Image Stretch="Uniform"
                                   Loaded="OnThumbImageLoaded"
                                   Unloaded="OnThumbImageUnloaded">
                                <Image.Style>
                                    <Style TargetType="Image">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsFolder}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Image.Style>
                            </Image>
                            <TextBlock Text="📁"
                                       FontSize="48"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsFolder}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>
                    <Grid Margin="0,2,0,0"
                          Width="{Binding TileSize, RelativeSource={RelativeSource AncestorType=controls:ThumbnailListControl}, Converter={StaticResource TileSizeConverter}, ConverterParameter=8}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Resolution}"
                                       Foreground="{DynamicResource TextBrush}"
                                       FontSize="{Binding ItemFontSize, RelativeSource={RelativeSource AncestorType=controls:ThumbnailListControl}}"
                                       HorizontalAlignment="Left"
                                       TextTrimming="CharacterEllipsis"
                                       TextWrapping="NoWrap" />
                            <TextBlock Text="{Binding FileSize}"
                                       Grid.Column="1"
                                       Foreground="{DynamicResource TextBrush}"
                                       FontSize="{Binding ItemFontSize, RelativeSource={RelativeSource AncestorType=controls:ThumbnailListControl}}"
                                       HorizontalAlignment="Right"
                                       TextWrapping="NoWrap" />
                        </Grid>
                        <TextBlock Grid.Row="1"
                                   Text="{Binding Name}"
                                   Foreground="{DynamicResource TextBrush}"
                                   FontSize="{Binding ItemFontSize, RelativeSource={RelativeSource AncestorType=controls:ThumbnailListControl}}"
                                   TextAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="NoWrap"
                                   ToolTip="{Binding Name}" />
                    </Grid>
                </StackPanel>
            </DataTemplate>
        </ListBox.ItemTemplate>
    </ListBox>
</UserControl>