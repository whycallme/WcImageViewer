<Window x:Class="WcImageViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:WcImageViewer.Controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="WC Image Viewer"
        Height="600"
        Width="800"
        MinHeight="600"
        MinWidth="800"
        Icon="/Assets/app.ico"
        Background="{DynamicResource WindowBackgroundBrush}"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowDrop="True"
        Drop="OnDrop"
        DragOver="OnDragOver"
        PreviewKeyDown="OnPreviewKeyDown"
        PreviewMouseMove="OnPreviewMouseMove"
        PreviewMouseLeftButtonUp="OnPreviewMouseLeftButtonUp"
        MouseLeave="OnMouseLeave">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="28"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border x:Name="ToolbarBorder"
                Grid.Row="0"
                Height="28"
                Background="{DynamicResource ChromeBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Image Grid.Column="0"
                       Source="/Assets/app.ico"
                       Width="16"
                       Height="16"
                       Margin="10,0,8,0"
                       VerticalAlignment="Center"
                       IsHitTestVisible="False" />

                <DockPanel Grid.Column="1"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"
                           HorizontalAlignment="Left"
                           LastChildFill="False">
                    <Border x:Name="CountChip"
                            DockPanel.Dock="Right"
                            Margin="8,0,0,0"
                            Padding="6,1"
                            VerticalAlignment="Center"
                            Background="{DynamicResource ChipBackgroundBrush}"
                            BorderBrush="{DynamicResource ChipBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="3"
                            Visibility="Collapsed"
                            IsHitTestVisible="False">
                        <TextBlock x:Name="CountChipText"
                                   FontSize="11"
                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                    </Border>

                    <TextBlock x:Name="ChromeTitle"
                               Text="WC Image Viewer"
                               Foreground="{DynamicResource TextBrush}"
                               FontSize="12"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="420"
                               IsHitTestVisible="False" />
                </DockPanel>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,0,10,0">
                    <Button Style="{StaticResource IconButtonStyle}"
                            Content="&#xE8E5;"
                            Click="OnOpenFileClick"
                            ToolTip="파일 열기 (F3)"
                            AutomationProperties.Name="파일 열기" />
                    <Button Style="{StaticResource IconButtonStyle}"
                            Content="&#xE838;"
                            Click="OnOpenFolderClick"
                            ToolTip="폴더 열기"
                            AutomationProperties.Name="폴더 열기" />

                    <Border Width="1"
                            Height="18"
                            Margin="4,0"
                            Background="{DynamicResource BorderBrush}"
                            VerticalAlignment="Center" />

                    <Button Style="{StaticResource IconButtonStyle}"
                            Content="&#xE76B;"
                            Click="OnPrevClick"
                            ToolTip="이전 (←)"
                            AutomationProperties.Name="이전 이미지" />
                    <Button Style="{StaticResource IconButtonStyle}"
                            Content="&#xE76C;"
                            Click="OnNextClick"
                            ToolTip="다음 (→)"
                            AutomationProperties.Name="다음 이미지" />
                    <Button Style="{StaticResource IconButtonStyle}"
                            Content="&#xE740;"
                            Click="OnFitClick"
                            ToolTip="창에 맞춤 (0)"
                            AutomationProperties.Name="창에 맞춤" />
                    <Button Style="{StaticResource IconButtonStyle}"
                            Content="1:1"
                            FontFamily="Segoe UI"
                            FontSize="10"
                            FontWeight="SemiBold"
                            Click="OnActualSizeClick"
                            ToolTip="실제 크기 (1)"
                            AutomationProperties.Name="실제 크기" />

                    <TextBox x:Name="ZoomBox"
                             Style="{StaticResource ChromeZoomBoxStyle}"
                             ToolTip="배율 (예: 100%)"
                             AutomationProperties.Name="배율"
                             KeyDown="OnZoomKeyDown"
                             LostFocus="OnZoomLostFocus" />

                    <Button Style="{StaticResource IconButtonStyle}"
                            Content="&#xE7F4;"
                            Click="OnFitWindowClick"
                            ToolTip="이미지 크기에 창 맞춤 (W)"
                            AutomationProperties.Name="이미지 크기에 창 맞춤" />
                    <Button x:Name="SlideshowButton"
                            Style="{StaticResource IconButtonStyle}"
                            Content="&#xE768;"
                            Click="OnSlideshowClick"
                            ToolTip="슬라이드쇼 시작 (S)"
                            AutomationProperties.Name="슬라이드쇼 시작" />
                    <Button x:Name="RecentButton"
                            Style="{StaticResource IconButtonStyle}"
                            Content="&#xE81C;"
                            Click="OnRecentClick"
                            ToolTip="최근 항목"
                            AutomationProperties.Name="최근 항목" />
                    <Button Style="{StaticResource IconButtonStyle}"
                            Content="&#xE713;"
                            Click="OnSettingsClick"
                            ToolTip="설정 (F5 / Ctrl+,)"
                            AutomationProperties.Name="설정" />
                </StackPanel>

                <StackPanel Grid.Column="3"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Style="{StaticResource WindowButtonStyle}"
                            Content="&#xE921;"
                            Click="OnMinimizeClick"
                            ToolTip="최소화"
                            AutomationProperties.Name="최소화" />
                    <Button x:Name="MaximizeButton"
                            Style="{StaticResource WindowButtonStyle}"
                            Click="OnMaximizeClick"
                            ToolTip="최대화"
                            AutomationProperties.Name="최대화">
                        <TextBlock x:Name="MaximizeGlyph" Text="&#xE922;" />
                    </Button>
                    <Button Style="{StaticResource CloseWindowButtonStyle}"
                            Content="&#xE8BB;"
                            Click="OnCloseClick"
                            ToolTip="닫기"
                            AutomationProperties.Name="닫기" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Background="{DynamicResource ImageAreaBrush}">
            <controls:ZoomPanControl x:Name="Viewer" />
            <TextBlock x:Name="EmptyText"
                       Text="이미지를 열어주세요&#10;파일을 끌어다 놓아도 됩니다"
                       Foreground="{DynamicResource TertiaryTextBrush}"
                       FontSize="16"
                       TextAlignment="Center"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       IsHitTestVisible="False" />
            <Border x:Name="InfoOverlayBorder"
                    Panel.ZIndex="5"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Margin="14"
                    MaxWidth="760"
                    Background="#B3000000"
                    CornerRadius="4"
                    Padding="10,6"
                    IsHitTestVisible="False"
                    Visibility="Collapsed">
                <TextBlock x:Name="InfoOverlayText"
                           Foreground="#F2F2F2"
                           FontSize="12"
                           TextWrapping="Wrap"
                           IsHitTestVisible="False" />
            </Border>
            <Border x:Name="NoticeBorder"
                    Panel.ZIndex="20"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="#CC000000"
                    CornerRadius="4"
                    Padding="24,10"
                    IsHitTestVisible="False"
                    Visibility="Collapsed"
                    Opacity="0">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="10" ShadowDepth="0" Opacity="0.8" />
                </Border.Effect>
                <TextBlock x:Name="NoticeText"
                           Foreground="#FFFFFF"
                           FontSize="20"
                           FontWeight="SemiBold"
                           TextAlignment="Center" />
            </Border>
            <controls:ThumbnailStrip x:Name="Thumbnails"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Bottom"
                                      Margin="0,0,0,16"
                                      MaxWidth="720"
                                      Panel.ZIndex="10" />
        </Grid>
    </Grid>
</Window>
