<Window x:Class="WcImageViewer.ListViewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:WcImageViewer.Controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="리스트 보기 - WC Image Viewer"
        Width="1200"
        Height="760"
        MinWidth="800"
        MinHeight="500"
        Icon="/WcImageViewer;component/Assets/app.ico"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ShowInTaskbar="True"
        Background="{DynamicResource WindowBackgroundBrush}"
        PreviewKeyDown="OnPreviewKeyDown">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="28"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="28" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <controls:TitleBar Grid.Row="0" Title="리스트 보기 - WC Image Viewer" />

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Margin="8,4">
            <Button x:Name="backButton" Style="{StaticResource IconButtonStyle}" Content="&#xE72B;" Click="BackButton_Click" ToolTip="뒤로" Margin="0,0,4,0" AutomationProperties.Name="뒤로" />
            <Button x:Name="forwardButton" Style="{StaticResource IconButtonStyle}" Content="&#xE72A;" Click="ForwardButton_Click" ToolTip="앞으로" Margin="0,0,4,0" AutomationProperties.Name="앞으로" />
            <Button x:Name="upButton" Style="{StaticResource IconButtonStyle}" Content="&#xE74A;" Click="UpButton_Click" ToolTip="위로" Margin="0,0,4,0" AutomationProperties.Name="위로" />
            <Button x:Name="refreshButton" Style="{StaticResource IconButtonStyle}" Content="&#xE72C;" Click="RefreshButton_Click" ToolTip="새로고침" Margin="0,0,8,0" AutomationProperties.Name="새로고침" />
            <TextBox x:Name="addressBox" Width="240" VerticalAlignment="Center" Margin="0,0,8,0" KeyDown="AddressBox_KeyDown" />
            <Button x:Name="deleteButton" Style="{StaticResource IconButtonStyle}" Content="&#xE74D;" Click="DeleteButton_Click" ToolTip="삭제" Margin="0,0,4,0" AutomationProperties.Name="삭제" />
            <Button x:Name="copyButton" Style="{StaticResource IconButtonStyle}" Content="&#xE8C8;" Click="CopyButton_Click" ToolTip="복사…" Margin="0,0,4,0" AutomationProperties.Name="복사" />
            <Button x:Name="moveButton" Style="{StaticResource IconButtonStyle}" Content="&#xE8DE;" Click="MoveButton_Click" ToolTip="이동…" Margin="0,0,8,0" AutomationProperties.Name="이동" />
            <Button x:Name="newFolderButton" Style="{StaticResource IconButtonStyle}" Content="&#xE8F4;" Click="NewFolderButton_Click" ToolTip="새 폴더 만들기" Margin="0,0,4,0" AutomationProperties.Name="새 폴더 만들기" />
            <Button x:Name="SlideshowButton" Style="{StaticResource IconButtonStyle}" Content="&#xE768;" Click="SlideshowButton_Click" ToolTip="슬라이드쇼" Margin="0,0,4,0" AutomationProperties.Name="슬라이드쇼" />
            <Button x:Name="SettingsButton" Style="{StaticResource IconButtonStyle}" Content="&#xE713;" Click="SettingsButton_Click" ToolTip="설정" Margin="0,0,8,0" AutomationProperties.Name="설정" />
            <Border Width="1" Background="{DynamicResource BorderBrush}" Margin="4,2,8,2" />
            <TextBlock Text="크기" VerticalAlignment="Center" Margin="0,0,4,0" />
            <Slider x:Name="sizeSlider"
                    Width="140"
                    Minimum="64"
                    Maximum="320"
                    TickFrequency="16"
                    IsSnapToTickEnabled="True"
                    VerticalAlignment="Center"
                    MouseLeftButtonUp="SizeSlider_MouseLeftButtonUp" />
            <TextBlock x:Name="sizeValueText"
                       Text="160"
                       Width="36"
                       VerticalAlignment="Center"
                       Margin="4,0,8,0" />
            <TextBlock Text="정렬" VerticalAlignment="Center" Margin="0,0,4,0" />
            <ComboBox x:Name="sortCombo"
                      Width="90"
                      VerticalAlignment="Center"
                      >
                <ComboBoxItem Content="이름" />
                <ComboBoxItem Content="수정일" />
                <ComboBoxItem Content="크기" />
                <ComboBoxItem Content="확장자" />
            </ComboBox>
            <ToggleButton x:Name="sortDescToggle"
                          Content="내림차순"
                          VerticalAlignment="Center"
                          Margin="8,0,0,0" />
        </StackPanel>

        <Grid x:Name="contentGrid" Grid.Row="2" Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260*" MinWidth="180" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="3*" MinWidth="200" />
            </Grid.ColumnDefinitions>

            <Grid x:Name="leftGrid" Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="80" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="2*" MinHeight="100" />
                </Grid.RowDefinitions>

                <controls:FolderTreeControl x:Name="folderTree" Grid.Row="0" />

                <GridSplitter x:Name="leftSplitter" Grid.Row="1"
                              Height="5"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Center"
                              ResizeDirection="Rows"
                              ResizeBehavior="PreviousAndNext"
                              DragCompleted="Splitter_DragCompleted"
                              Background="{DynamicResource BorderBrush}">
                    <GridSplitter.Style>
                        <Style TargetType="GridSplitter">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </GridSplitter.Style>
                </GridSplitter>

                <Border x:Name="previewHost" Grid.Row="2"
                        Background="{DynamicResource SurfaceBrush}">
                    <Grid>
                        <Image x:Name="previewImage"
                               Stretch="Uniform"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                        <TextBlock x:Name="previewStatus"
                                   Text="미리보기 불가"
                                   Foreground="{DynamicResource TertiaryTextBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Visibility="Collapsed" />
                    </Grid>
                </Border>
            </Grid>

            <GridSplitter x:Name="columnSplitter" Grid.Column="1"
                          Width="5"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Stretch"
                          ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext"
                          DragCompleted="Splitter_DragCompleted"
                          Background="{DynamicResource BorderBrush}">
                <GridSplitter.Style>
                    <Style TargetType="GridSplitter">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </GridSplitter.Style>
            </GridSplitter>

            <Grid x:Name="rightGrid" Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="100" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="160" MinHeight="80" />
                </Grid.RowDefinitions>

                <controls:ThumbnailListControl x:Name="thumbList" Grid.Row="0" />

                <GridSplitter x:Name="rightSplitter" Grid.Row="1"
                              Height="5"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Center"
                              ResizeDirection="Rows"
                              ResizeBehavior="PreviousAndNext"
                              DragCompleted="Splitter_DragCompleted"
                              Background="{DynamicResource BorderBrush}">
                    <GridSplitter.Style>
                        <Style TargetType="GridSplitter">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </GridSplitter.Style>
                </GridSplitter>

                <Border Grid.Row="2"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        Padding="8">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="infoText"
                                   Foreground="{DynamicResource TextBrush}"
                                   TextWrapping="Wrap" />
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
        <TextBlock x:Name="progressText"
                   Grid.Row="3"
                   Margin="8,2"
                   Foreground="{DynamicResource TextBrush}"
                   Visibility="Collapsed" />
        <Border x:Name="NoticeBorder"
                Grid.RowSpan="4"
                Panel.ZIndex="20"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{DynamicResource NoticeBackgroundBrush}"
                CornerRadius="4"
                Padding="24,10"
                IsHitTestVisible="False"
                Visibility="Collapsed">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="10" ShadowDepth="0" Opacity="0.8" />
            </Border.Effect>
            <TextBlock x:Name="NoticeText"
                       Foreground="{DynamicResource NoticeTextBrush}"
                       FontSize="20"
                       FontWeight="SemiBold"
                       TextAlignment="Center" />
        </Border>
    </Grid>
</Window>