<Window x:Class="WcImageViewer.RenameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="이름 바꾸기"
        Width="430"
        Height="170"
        Icon="/Assets/app.ico"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource WindowBackgroundBrush}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="새 파일 이름"
                   Foreground="#E8E8E8"
                   Margin="0,0,0,6" />

        <TextBox x:Name="NameBox"
                 Grid.Row="1"
                 Height="28"
                 VerticalAlignment="Top"
                 Background="#2A2A2C"
                 Foreground="#E8E8E8"
                 BorderBrush="#4A4A4E"
                 BorderThickness="1"
                 Padding="6,3"
                 FontSize="13" />

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Content="취소" IsCancel="True" />
            <Button Content="확인" IsDefault="True" Click="OnOkClick" />
        </StackPanel>
    </Grid>
</Window>
