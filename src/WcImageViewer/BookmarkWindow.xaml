<Window x:Class="WcImageViewer.BookmarkWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="책갈피 관리"
        Width="620"
        Height="420"
        Icon="/Assets/app.ico"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource WindowBackgroundBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ListBox x:Name="BookmarkList"
                 Background="#252526"
                 Foreground="#E8E8E8"
                 BorderBrush="#3A3A3D"
                 BorderThickness="1"
                 Margin="0,0,0,12">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="4,2">
                        <TextBlock Text="{Binding}" Foreground="#E8E8E8" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button x:Name="AddCurrentButton"
                    Content="현재 이미지 추가"
                    HorizontalAlignment="Left"
                    Click="OnAddCurrentClick" />

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="열기" Click="OnOpenClick" />
                <Button Content="삭제" Click="OnDeleteClick" />
                <Button Content="닫기" IsCancel="True" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
