<Window x:Class="WcImageViewer.SaveAsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:WcImageViewer.Controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="다른 이름으로 저장"
        Width="480"
        Height="470"
        Icon="/Assets/app.ico"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="28"
                            ResizeBorderThickness="0"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="28" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:TitleBar Grid.Row="0" Title="다른 이름으로 저장" />

        <Grid Grid.Row="1" Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="저장 폴더"
                       Foreground="{DynamicResource TextBrush}"
                       Margin="0,0,0,6" />

            <DockPanel Grid.Row="1" LastChildFill="True" Margin="0,0,0,12">
                <Button DockPanel.Dock="Right"
                        Content="찾아보기"
                        Margin="8,0,0,0"
                        Click="OnBrowseClick" />
                <TextBox x:Name="FolderBox"
                         Height="28"
                         Background="{DynamicResource SurfaceBrush}"
                         Foreground="{DynamicResource TextBrush}"
                         BorderBrush="{DynamicResource InputBorderBrush}"
                         BorderThickness="1"
                         Padding="6,3"
                         FontSize="13" />
            </DockPanel>

            <TextBlock Grid.Row="2"
                       Text="파일 이름"
                       Foreground="{DynamicResource TextBrush}"
                       Margin="0,0,0,6" />

            <TextBox x:Name="NameBox"
                     Grid.Row="3"
                     Height="28"
                     Background="{DynamicResource SurfaceBrush}"
                     Foreground="{DynamicResource TextBrush}"
                     BorderBrush="{DynamicResource InputBorderBrush}"
                     BorderThickness="1"
                     Padding="6,3"
                     FontSize="13"
                     Margin="0,0,0,12" />

            <TextBlock Grid.Row="4"
                       Text="파일 형식"
                       Foreground="{DynamicResource TextBrush}"
                       Margin="0,0,0,6" />

            <ComboBox x:Name="FormatBox"
                      Grid.Row="5"
                      Height="28"
                      SelectionChanged="OnFormatSelectionChanged"
                      Margin="0,0,0,12" />

            <Grid Grid.Row="6" Margin="0,0,0,8" MinHeight="52">
                <StackPanel x:Name="JpegPanel" Visibility="Collapsed" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="품질"
                               Foreground="{DynamicResource TextBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0" />
                    <Slider x:Name="JpegQualitySlider"
                            Minimum="1"
                            Maximum="100"
                            Value="95"
                            TickFrequency="1"
                            IsSnapToTickEnabled="True"
                            Width="220"
                            VerticalAlignment="Center"
                            ValueChanged="OnJpegQualityChanged" />
                    <TextBlock x:Name="JpegQualityValue"
                               Text="95"
                               Foreground="{DynamicResource TextBrush}"
                               VerticalAlignment="Center"
                               Margin="10,0,0,0"
                               Width="32" />
                </StackPanel>

                <StackPanel x:Name="WebPPanel" Visibility="Collapsed" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="품질"
                               Foreground="{DynamicResource TextBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0" />
                    <Slider x:Name="WebPQualitySlider"
                            Minimum="1"
                            Maximum="100"
                            Value="90"
                            TickFrequency="1"
                            IsSnapToTickEnabled="True"
                            Width="180"
                            VerticalAlignment="Center"
                            ValueChanged="OnWebPQualityChanged" />
                    <TextBlock x:Name="WebPQualityValue"
                               Text="90"
                               Foreground="{DynamicResource TextBrush}"
                               VerticalAlignment="Center"
                               Margin="10,0,0,0"
                               Width="32" />
                    <CheckBox x:Name="WebPLosslessCheck"
                              Content="무손실 저장"
                              Foreground="{DynamicResource TextBrush}"
                              VerticalAlignment="Center"
                              Margin="14,0,0,0" />
                </StackPanel>

                <StackPanel x:Name="TiffPanel" Visibility="Collapsed" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="압축"
                               Foreground="{DynamicResource TextBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0" />
                    <ComboBox x:Name="TiffCompressionBox"
                              Height="26"
                              MinWidth="140">
                        <ComboBoxItem Content="None" IsSelected="True" />
                        <ComboBoxItem Content="LZW" />
                        <ComboBoxItem Content="RLE" />
                        <ComboBoxItem Content="Zip" />
                    </ComboBox>
                </StackPanel>

                <StackPanel x:Name="PngPanel" Visibility="Collapsed" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox x:Name="PngInterlaceCheck"
                              Content="인터레이스 저장"
                              Foreground="{DynamicResource TextBrush}"
                              VerticalAlignment="Center" />
                </StackPanel>
            </Grid>

            <StackPanel x:Name="AnimationPanel" Grid.Row="7" Visibility="Collapsed" Orientation="Vertical" VerticalAlignment="Center" Margin="0,0,0,8">
                <CheckBox x:Name="AnimationKeepCheck"
                          Content="애니메이션 유지"
                          Foreground="{DynamicResource TextBrush}"
                          VerticalAlignment="Center"
                          IsChecked="True" />
                <TextBlock x:Name="GifColorNote"
                           Text="GIF는 256색 제한으로 색상이 줄어들 수 있습니다."
                           Foreground="{DynamicResource TextBrush}"
                           FontSize="12"
                           Margin="0,4,0,0" />
            </StackPanel>

            <StackPanel Grid.Row="9"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom">
                <Button x:Name="MainCancelButton" Content="취소" IsCancel="True" Click="OnSaveCancelClick" />
                <Button x:Name="SaveButton" Content="저장" IsDefault="True" Click="OnSaveClick" />
            </StackPanel>

            <StackPanel Grid.Row="10"
                        x:Name="SaveProgressPanel"
                        Visibility="Collapsed"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="0,10,0,0">
                <ProgressBar x:Name="SaveProgressBar"
                             IsIndeterminate="True"
                             VerticalAlignment="Center"
                             Margin="0,0,10,0" />
                <Button x:Name="SaveCancelButton"
                        Content="취소"
                        Click="OnSaveCancelClick" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
