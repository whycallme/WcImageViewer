<Window x:Class="WcImageViewer.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="설정"
        Width="760"
        Height="620"
        Icon="/Assets/app.ico"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource WindowBackgroundBrush}"
        PreviewKeyDown="OnPreviewShortcutKeyDown">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ListBox x:Name="CategoryList"
                 Grid.Row="0"
                 Grid.Column="0"
                 Background="Transparent"
                 BorderThickness="0"
                 Foreground="#E8E8E8"
                 Margin="0,0,14,0"
                 SelectionChanged="OnCategoryChanged">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Foreground" Value="#E8E8E8" />
                    <Setter Property="Padding" Value="10,9" />
                    <Setter Property="Margin" Value="0,0,0,2" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="ItemBorder"
                                        Background="Transparent"
                                        CornerRadius="3"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="ItemBorder" Property="Background" Value="#3A3A3D" />
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="ItemBorder" Property="Background" Value="#333336" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBoxItem Content="일반" />
            <ListBoxItem Content="보기/창" />
            <ListBoxItem Content="파일/편집" />
            <ListBoxItem Content="단축키" />
            <ListBoxItem Content="파일 연결" />
        </ListBox>

        <ScrollViewer Grid.Row="0"
                      Grid.Column="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Grid>
                <StackPanel x:Name="GeneralPanel">
                    <TextBlock Text="일반"
                               Foreground="#F0F0F0"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Margin="0,0,0,16" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="슬라이드쇼 간격"
                                   Foreground="#E8E8E8"
                                   VerticalAlignment="Center" />
                        <ComboBox x:Name="IntervalBox"
                                  Grid.Column="1"
                                  Height="26"
                                  VerticalContentAlignment="Center" />
                        <TextBlock Text="초"
                                   Grid.Column="2"
                                   Foreground="#E8E8E8"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <CheckBox x:Name="SlideshowRepeatCheck"
                              Content="슬라이드쇼 반복 재생"
                              Foreground="#E8E8E8"
                              Margin="0,16,0,0" />

                    <CheckBox x:Name="SlideshowRandomCheck"
                              Content="슬라이드쇼 랜덤 재생"
                              Foreground="#E8E8E8"
                              Margin="0,10,0,0" />

                    <TextBlock Text="랜덤 재생은 한 바퀴 무작위 순서로 보여준 뒤 반복 설정을 따릅니다."
                               Foreground="#777777"
                               TextWrapping="Wrap"
                               Margin="0,10,0,0" />

                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="180" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="창 열기 방식"
                                   Foreground="#E8E8E8"
                                   VerticalAlignment="Center" />
                        <ComboBox x:Name="WindowModeBox"
                                  Grid.Column="1"
                                  Height="26"
                                  VerticalContentAlignment="Center" />
                    </Grid>

                    <TextBlock Text="창 열기 방식은 다음 실행부터 적용됩니다."
                               Foreground="#777777"
                               Margin="0,12,0,0" />
                </StackPanel>

                <StackPanel x:Name="ViewPanel" Visibility="Collapsed">
                    <TextBlock Text="보기/창"
                               Foreground="#F0F0F0"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Margin="0,0,0,16" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="180" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="기본 표시 배율"
                                   Foreground="#E8E8E8"
                                   VerticalAlignment="Center" />
                        <ComboBox x:Name="DefaultZoomBox"
                                  Grid.Column="1"
                                  Height="26"
                                  VerticalContentAlignment="Center"
                                  SelectionChanged="OnDefaultZoomChanged"
                                  ToolTip="자동 창 맞춤이 켜져 있으면 적용되지 않습니다." />
                    </Grid>

                    <CheckBox x:Name="ThumbnailsCheck"
                              Content="썸네일 스트립 항상 표시"
                              Foreground="#E8E8E8"
                              Margin="0,16,0,0" />

                    <CheckBox x:Name="AutoFitCheck"
                              Content="이미지를 열 때 창을 이미지에 맞춤"
                              Foreground="#E8E8E8"
                              Margin="0,12,0,0" />

                    <Grid Margin="0,20,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="180" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="파일 끝에서 이동"
                                   Foreground="#E8E8E8"
                                   VerticalAlignment="Center" />
                        <ComboBox x:Name="NavigationWrapBox"
                                  Grid.Column="1"
                                  Height="26"
                                  VerticalContentAlignment="Center" />
                    </Grid>

                    <CheckBox x:Name="NavigationNoticeCheck"
                              Content="경계에서 알림 메시지 표시"
                              Foreground="#E8E8E8"
                              Margin="0,12,0,0" />

                    <TextBlock Text="마지막 파일의 다음, 첫 파일의 이전에 적용됩니다. 알림은 화면 중앙에 잠깐 표시됩니다."
                               Foreground="#777777"
                               TextWrapping="Wrap"
                               Margin="0,10,0,0" />
                </StackPanel>

                <StackPanel x:Name="FilePanel" Visibility="Collapsed">
                    <TextBlock Text="파일/편집"
                               Foreground="#F0F0F0"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Margin="0,0,0,16" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="편집 앱"
                                   Foreground="#E8E8E8"
                                   VerticalAlignment="Center" />
                        <TextBox x:Name="EditorPathBox"
                                 Grid.Column="1"
                                 Height="26"
                                 Background="#2A2A2C"
                                 Foreground="#E8E8E8"
                                 BorderBrush="#4A4A4E"
                                 BorderThickness="1"
                                 Padding="4,2"
                                 VerticalContentAlignment="Center"
                                 ToolTip="Ctrl+E로 열 외부 편집 프로그램" />
                        <Button Content="찾아보기"
                                Grid.Column="2"
                                Margin="6,0,0,0"
                                Click="OnBrowseEditorClick" />
                    </Grid>

                    <CheckBox x:Name="ConfirmDeleteCheck"
                              Content="삭제 전에 확인"
                              Foreground="#E8E8E8"
                              Margin="0,20,0,0" />

                    <CheckBox x:Name="RecycleBinCheck"
                              Content="휴지통으로 이동"
                              Foreground="#E8E8E8"
                              Margin="0,10,0,0" />

                    <TextBlock Text="휴지통을 끄면 영구 삭제이며 항상 확인합니다."
                               Foreground="#777777"
                               Margin="0,14,0,0" />
                </StackPanel>

                <StackPanel x:Name="ShortcutPanel" Visibility="Collapsed">
                    <TextBlock Text="단축키"
                               Foreground="#F0F0F0"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Margin="0,0,0,10" />
                    <TextBlock Text="변경을 누른 뒤 새 단축키를 누르세요. Esc는 취소입니다."
                               Foreground="#777777"
                               TextWrapping="Wrap"
                               Margin="0,0,0,14" />
                    <StackPanel x:Name="ShortcutRowsPanel" />
                </StackPanel>

                <StackPanel x:Name="AssociationPanel" Visibility="Collapsed">
                    <TextBlock Text="파일 연결"
                               Foreground="#F0F0F0"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Margin="0,0,0,10" />
                    <DockPanel>
                        <TextBlock Text="이 앱으로 열 확장자"
                                   Foreground="#E8E8E8"
                                   DockPanel.Dock="Left"
                                   VerticalAlignment="Center" />
                        <Button Content="모두 해제"
                                HorizontalAlignment="Right"
                                DockPanel.Dock="Right"
                                FontSize="11"
                                Padding="6,2"
                                Click="OnClearAllExtensionsClick" />
                    </DockPanel>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Background="#262628"
                                BorderBrush="#3A3A3D"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="12,10"
                                Margin="0,0,5,0">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="이미지"
                                               Foreground="#E8E8E8"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                    <Button Content="이미지 모두 선택"
                                            HorizontalAlignment="Right"
                                            FontSize="11"
                                            Padding="6,2"
                                            Click="OnSelectAllImagesClick" />
                                </Grid>
                                <ScrollViewer Height="240"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled"
                                              Margin="0,6,0,0">
                                    <StackPanel x:Name="ImageExtensionPanel" />
                                </ScrollViewer>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1"
                                Background="#262628"
                                BorderBrush="#3A3A3D"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="12,10"
                                Margin="5,0,0,0">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="압축파일"
                                               Foreground="#E8E8E8"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                    <Button Content="압축파일 모두 선택"
                                            HorizontalAlignment="Right"
                                            FontSize="11"
                                            Padding="6,2"
                                            Click="OnSelectAllArchivesClick" />
                                </Grid>
                                <ScrollViewer Height="240"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled"
                                              Margin="0,6,0,0">
                                    <StackPanel x:Name="ArchiveExtensionPanel" />
                                </ScrollViewer>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <TextBlock Text="파일 연결은 Windows 기본 앱 설정에서 확인이 필요할 수 있습니다."
                               Foreground="#777777"
                               TextWrapping="Wrap"
                               Margin="0,16,0,0" />
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <TextBlock Grid.Row="1"
                   Grid.Column="0"
                   Grid.ColumnSpan="2"
                   Text="설정은 settings.json에 저장됩니다."
                   Foreground="#777777"
                   VerticalAlignment="Center"
                   Margin="0,14,180,0" />

        <StackPanel Grid.Row="1"
                    Grid.Column="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,14,0,0">
            <Button Content="취소" IsCancel="True" />
            <Button Content="확인" IsDefault="True" Click="OnOkClick" />
        </StackPanel>
    </Grid>
</Window>
