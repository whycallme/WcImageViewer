<Window x:Class="WcImageViewer.PrintWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:WcImageViewer.Controls"
        xmlns:services="clr-namespace:WcImageViewer.Services"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="인쇄"
        Width="760"
        Height="540"
        Icon="/WcImageViewer;component/Assets/app.ico"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="28"
                            ResizeBorderThickness="0"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="28" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:TitleBar Grid.Row="0" Title="인쇄" />

        <Grid Grid.Row="1" Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,0">
                <TextBlock x:Name="DocumentNameText"
                           Foreground="{DynamicResource TextBrush}"
                           Margin="0,0,0,12"
                           TextTrimming="CharacterEllipsis" />

                <TextBlock Text="프린터"
                           Foreground="{DynamicResource TextBrush}"
                           Margin="0,0,0,6" />
                <ComboBox x:Name="PrinterBox"
                          Height="28"
                          Margin="0,0,0,12" />

                <TextBlock Text="용지"
                           Foreground="{DynamicResource TextBrush}"
                           Margin="0,0,0,6" />
                <ComboBox x:Name="PaperBox"
                          Height="28"
                          Margin="0,0,0,12">
                    <ComboBoxItem Content="A4" Tag="{x:Static services:PrintPaperSize.A4}" IsSelected="True" />
                    <ComboBoxItem Content="A5" Tag="{x:Static services:PrintPaperSize.A5}" />
                    <ComboBoxItem Content="레터" Tag="{x:Static services:PrintPaperSize.Letter}" />
                    <ComboBoxItem Content="리걸" Tag="{x:Static services:PrintPaperSize.Legal}" />
                </ComboBox>

                <TextBlock Text="방향"
                           Foreground="{DynamicResource TextBrush}"
                           Margin="0,0,0,6" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <RadioButton x:Name="PortraitRadio"
                                 Content="세로"
                                 GroupName="PrintOrientation"
                                 IsChecked="True"
                                 Margin="0,0,16,0" />
                    <RadioButton x:Name="LandscapeRadio"
                                 Content="가로"
                                 GroupName="PrintOrientation" />
                </StackPanel>

                <TextBlock Text="맞춤"
                           Foreground="{DynamicResource TextBrush}"
                           Margin="0,0,0,6" />
                <ComboBox x:Name="FitBox"
                          Height="28"
                          Margin="0,0,0,12">
                    <ComboBoxItem Content="페이지에 맞춤" Tag="{x:Static services:PrintFitMode.FitToPage}" IsSelected="True" />
                    <ComboBoxItem Content="원본 크기" Tag="{x:Static services:PrintFitMode.ActualSize}" />
                    <ComboBoxItem Content="채우기" Tag="{x:Static services:PrintFitMode.Fill}" />
                </ComboBox>

                <TextBlock Text="여백 (mm)"
                           Foreground="{DynamicResource TextBrush}"
                           Margin="0,0,0,6" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBox x:Name="MarginLeftBox"
                             Width="56"
                             Height="28"
                             Text="10"
                             Margin="0,0,6,0"
                             Background="{DynamicResource SurfaceBrush}"
                             Foreground="{DynamicResource TextBrush}"
                             BorderBrush="{DynamicResource InputBorderBrush}"
                             BorderThickness="1"
                             Padding="6,3" />
                    <TextBox x:Name="MarginTopBox"
                             Width="56"
                             Height="28"
                             Text="10"
                             Margin="0,0,6,0"
                             Background="{DynamicResource SurfaceBrush}"
                             Foreground="{DynamicResource TextBrush}"
                             BorderBrush="{DynamicResource InputBorderBrush}"
                             BorderThickness="1"
                             Padding="6,3" />
                    <TextBox x:Name="MarginRightBox"
                             Width="56"
                             Height="28"
                             Text="10"
                             Margin="0,0,6,0"
                             Background="{DynamicResource SurfaceBrush}"
                             Foreground="{DynamicResource TextBrush}"
                             BorderBrush="{DynamicResource InputBorderBrush}"
                             BorderThickness="1"
                             Padding="6,3" />
                    <TextBox x:Name="MarginBottomBox"
                             Width="56"
                             Height="28"
                             Text="10"
                             Background="{DynamicResource SurfaceBrush}"
                             Foreground="{DynamicResource TextBrush}"
                             BorderBrush="{DynamicResource InputBorderBrush}"
                             BorderThickness="1"
                             Padding="6,3" />
                </StackPanel>

                <TextBlock Text="매수"
                           Foreground="{DynamicResource TextBrush}"
                           Margin="0,0,0,6" />
                <TextBox x:Name="CopiesBox"
                         Width="56"
                         Height="28"
                         Text="1"
                         Background="{DynamicResource SurfaceBrush}"
                         Foreground="{DynamicResource TextBrush}"
                         BorderBrush="{DynamicResource InputBorderBrush}"
                         BorderThickness="1"
                         Padding="6,3" />
            </StackPanel>

            <Border x:Name="PreviewBorder"
                    Grid.Row="0"
                    Grid.Column="1"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource InputBorderBrush}"
                    BorderThickness="1"
                    ClipToBounds="True">
                <Canvas x:Name="PreviewCanvas" />
            </Border>

            <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="ErrorText"
                           Foreground="Red"
                           Visibility="Collapsed"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap" />
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button x:Name="CancelButton"
                            Content="취소"
                            IsCancel="True"
                            Click="OnCancelClick"
                            Margin="0,0,8,0" />
                    <Button x:Name="PrintButton"
                            Content="인쇄"
                            IsDefault="True"
                            Click="OnPrintClick" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>